[debug] [2026-08-27T22:09:44.528Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/hours-tracker-505617/rulesets {"name":"projects/hours-tracker-505617/rulesets/2e9823ea-ee31-43a9-abb1-2ecace2f126c","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null && request.auth.token.email_verified == true;\n    }\n\n    function approved() {\n      return signedIn()\n        && request.auth.token.email in [\n          \"sandiepietz@gmail.com\",\n          \"spietzfadap@gmail.com\",\n          \"tspillersfadap@gmail.com\",\n          \"mitchellpietz@gmail.com\",\n          \"arouttenfadap@gmail.com\",\n          \"peggerfadap@gmail.com\",\n          \"gwrennfadap@gmail.com\"\n        ];\n    }\n\n    match /users/{userId}/entries/{entryId} {\n      allow read, create, update, delete: if approved()\n        && request.auth.uid == userId;\n    }\n\n    match /users/{userId}/quickNotes/{noteId} {\n      allow read, create, update, delete: if approved()\n        && request.auth.uid == userId;\n    }\n\n    match /users/{userId}/onCallSchedules/{scheduleId} {\n      allow read, create, update, delete: if approved()\n        && request.auth.uid == userId;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-27T22:09:44.532271Z","metadata":{"services":["cloud.firestore"]}}
