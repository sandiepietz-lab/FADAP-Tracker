rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function approved() {
      return signedIn()
        && request.auth.token.email in [
          "sandiepietz@gmail.com",
          "spietzfadap@gmail.com",
          "tspillersfadap@gmail.com",
          "mitchellpietz@gmail.com",
          "arouttenfadap@gmail.com",
          "peggerfadap@gmail.com",
          "gwrennfadap@gmail.com",
          "bdumasfadap@gmail.com",
          "bbedillionfadap@gmail.com",
          "culrichfadap@gmail.com",
          "dmartinezfadap@gmail.com",
          "dkrupskifadap@gmail.com",
          "darnettfadap@gmail.com",
          "ealexanderfadap@gmail.com",
          "ewatermanfadap@gmail.com",
          "gsteinkefadap@gmail.com",
          "jhollingsworthfadap@gmail.com",
          "jwallerfadap@gmail.com",
          "jnevantfadap@gmail.com",
          "klynchfadap@gmail.com",
          "kbullfadap@gmail.com",
          "llightfadap@gmail.com",
          "mstidomfadap@gmail.com",
          "nbergrenfadap@gmail.com",
          "nrossfadap@gmail.com",
          "pspencefadap@gmail.com",
          "pbullardfadap@gmail.com",
          "rtumlinsonfadap@gmail.com",
          "sflowersfadap@gmail.com",
          "sgrumfadap@gmail.com",
          "shartmanfadap@gmail.com",
          "tdawsonfadap@gmail.com",
          "wforsythfadap@gmail.com"
        ];
    }

    function administrationAccess() {
      return request.auth.token.email in [
        "tspillersfadap@gmail.com", "peggerfadap@gmail.com",
        "arouttenfadap@gmail.com", "spietzfadap@gmail.com"
      ];
    }

    function administrationEntry(data) {
      return data.get('activity', '') == 'Administration';
    }

    function validAdministration(data) {
      return !administrationEntry(data) || (administrationAccess()
        && data.detail in ['RSP', 'Union Meetings', 'Company Meetings']
        && data.duration is number && data.duration > 0 && data.duration <= 86400);
    }

    match /users/{userId}/entries/{entryId} {
      allow read: if approved() && request.auth.uid == userId;
      allow create: if approved() && request.auth.uid == userId
        && validAdministration(request.resource.data);
      allow update: if approved() && request.auth.uid == userId
        && (!administrationEntry(resource.data) || administrationAccess())
        && validAdministration(request.resource.data);
      allow delete: if approved() && request.auth.uid == userId
        && (!administrationEntry(resource.data) || administrationAccess());
    }

    match /users/{userId}/quickNotes/{noteId} {
      allow read, create, update, delete: if approved()
        && request.auth.uid == userId;
    }

    match /users/{userId}/onCallSchedules/{scheduleId} {
      allow read, create, update, delete: if approved()
        && request.auth.uid == userId;
    }
  }
}
